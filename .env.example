# Reel2AICart env — copy to .env (never commit .env)
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/reel2aicart?sslmode=require"
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="https://your-app.vercel.app"
MODAL_WEBHOOK_URL=""
# Shared secret: Vercel embeds it in the ingest payload, Modal checks it.
# Same value in Modal secret "modal-auth" (MODAL_INGEST_SECRET) + Vercel env.
MODAL_INGEST_SECRET=""
# Meta Instagram (Unified Login config) — token from dashboard Add-account (system-user, never expires)
META_GRAPH_TOKEN=""
# IG business account id (from {page-id}?fields=instagram_business_account, or Add-account wizard)
IG_USER_ID=""
# Meta App ID + secret (App settings → Basic) — only needed for the 60-day token exchange fallback
META_APP_ID=""
META_APP_SECRET=""
# Enrichment providers (Modal secret "app-config"; muse = Meta Model API, hackathon default)
VISION_PROVIDER="muse"
EMBED_PROVIDER="muse"
META_BASE_URL="https://api.meta.ai/v1"
MUSE_VISION_MODEL="muse-spark-1.3-contributor"
MODEL_API_KEY=""
# No Muse embeddings route exists in the Model API reference — vectors fall
# back to hash unless MUSE_EMBED_MODEL is ever set by Meta.
# Bearer secret guarding Vercel cron endpoints (/api/scan-worker, /api/attribute-orders).
# Generate with: openssl rand -hex 32 — same value must be set as the cron
# Authorization header in Vercel (cron config) so workers don't 401.
CRON_SECRET=""
# DeepInfra bge-large embeddings (only needed if EMBED_PROVIDER=deepinfra;
# also powers server-side bge re-rank in /mcp + /agent search)
DEEPINFRA_TOKEN=""
DEEPINFRA_EMBED_MODEL="BAAI/bge-large-en-v1.5"
# Muse embeddings endpoint (only needed if EMBED_PROVIDER=muse; if unset,
# enrichment falls back to hash vectors and vision still uses MODEL_API_KEY)
MUSE_EMBED_MODEL=""
# /agent Ask-tab second provider (Grok). Muse (Ask default) reuses MODEL_API_KEY.
XAI_API_KEY=""
GROK_MODEL=""
